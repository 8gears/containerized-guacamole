# Example Configuration
#
POSTGRES_USER=guacadb
POSTGRES_PASSWORD=xxxx

# The hostname NGINX routes on. Add additional hostnames with commas
# to allow access via secondary names.
VIRTUAL_HOST=subdomain.example.com,local-name.local

# Only the public hostname is sent to Let's Encrypt.
LETSENCRYPT_HOST=subdomain.example.com
LETSENCRYPT_EMAIL=me@example.com

# Uncomment to use the Let's Encrypt staging CA while testing.
# Certificates will not be browser-trusted but are not rate limited.
# LETSENCRYPT_TEST=true
